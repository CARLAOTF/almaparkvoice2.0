-- LÓGICA DO ANTI-AFK
-- ================================
local function antiAfkPulse() --[span_12](start_span)[span_12](end_span)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Unknown, false, game) --[span_13](start_span)[span_13](end_span)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Unknown, false, game) --[span_14](start_span)[span_14](end_span)
    end)
    
    pcall(function()
        local position = UserInputService:GetMouseLocation() --[span_15](start_span)[span_15](end_span)
        VirtualInputManager:SendMouseMoveEvent(position.X, position.Y, game) --[span_16](start_span)[span_16](end_span)
    end)

    local env = (getgenv and getgenv()) or _G --[span_17](start_span)[span_17](end_span)
    local fire = env.firesignal or env.fireSignal --[span_18](start_span)[span_18](end_span)
    if type(fire) == "function" then --[span_19](start_span)[span_19](end_span)
        pcall(fire, UserInputService.WindowFocused) --[span_20](start_span)[span_20](end_span)
    end
end

