-- ================================
-- LÓGICA DO AUTO FARM
-- ================================
local function iniciarFarm()
    while getgenv().AutoFarmSouls do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
            local hrp = char.HumanoidRootPart
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local pastaSouls = workspace:FindFirstChild("SeasonalCollectibles")
            
            if pastaSouls then
                for _, soul in ipairs(pastaSouls:GetChildren()) do
                    if not getgenv().AutoFarmSouls then break end
                    
                    if string.match(soul.Name, "^Soul") then
                        local targetCFrame
                        if soul:IsA("BasePart") then
                            targetCFrame = soul.CFrame
                        elseif soul:IsA("Model") then
                            local part = soul.PrimaryPart or soul:FindFirstChildWhichIsA("BasePart", true)
                            if part then targetCFrame = part.CFrame end
                        end
                        
                        if targetCFrame then
                            local posFrente = (targetCFrame * CFrame.new(0, 0, 6)).Position
                            local posTras = (targetCFrame * CFrame.new(0, 0, -6)).Position
                            
                            hrp.CFrame = CFrame.new(posFrente, targetCFrame.Position)
                            task.wait(0.2)
                            
                            local maxWait = tonumber(LimiteInput.Text) or 1
                            local passadas = tonumber(PassadasInput.Text) or 5
                            local tpDelay = tonumber(DelayTpInput.Text) or 0.5
                            
                            for i = 1, passadas do
                                if not getgenv().AutoFarmSouls or soul.Parent == nil then break end
                                
                                local destinoAtual = (i % 2 ~= 0) and posTras or posFrente
                                humanoid:MoveTo(destinoAtual)
                                
                                local tempoGasto = 0
                                while getgenv().AutoFarmSouls and soul.Parent ~= nil and tempoGasto < maxWait do
                                    if (hrp.Position - destinoAtual).Magnitude < 1.5 then
                                        break
                                    end
                                    task.wait(0.1)
                                    tempoGasto = tempoGasto + 0.1
                                end
                            end
                            
                            humanoid:MoveTo(hrp.Position)
                            
                            if getgenv().AutoFarmSouls then
                                task.wait(tpDelay)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

